{
  "name": "@subloom/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --config ../../wrangler.jsonc --outdir dist",
    "dev": "wrangler dev --config ../../wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@subloom/core": "workspace:*",
    "@subloom/web": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@subloom/db": "workspace:*",
    "@subloom/server": "workspace:*",
    "drizzle-orm": "catalog:"
  }
}

{
  "format": "mihomo-yaml",
  "proxies": [
    {
      "name": "SS anchors",
      "type": "ss",
      "server": "ss.example.com",
      "port": 8388,
      "udp": true,
      "cipher": "aes-128-gcm",
      "password": "12e4",
      "extra": {
        "mihomo": {
          "ip-version": "ipv4"
        }
      }
    },
    {
      "name": "SS v2ray-plugin",
      "type": "ss",
      "server": "v2.example.com",
      "port": 443,
      "cipher": "aes-128-gcm",
      "password": "fake-v2",
      "plugin": {
        "type": "v2ray-plugin",
        "mode": "websocket",
        "host": "v2.example.com",
        "path": "/v2",
        "tls": true,
        "mux": true
      },
      "extra": {
        "mihomo": {
          "plugin-opts": {
            "v2ray-http-upgrade": true
          }
        }
      }
    },
    {
      "name": "SS shadow-tls",
      "type": "ss",
      "server": "st.example.com",
      "port": 443,
      "cipher": "2022-blake3-aes-128-gcm",
      "password": "AAAAAAAAAAAAAAAAAAAAAA==",
      "extra": {
        "mihomo": {
          "plugin": "shadow-tls",
          "plugin-opts": {
            "host": "www.example.com",
            "password": "fake-st",
            "version": 3
          }
        }
      }
    },
    {
      "name": "SSR",
      "type": "ssr",
      "server": "ssr.example.com",
      "port": 443,
      "cipher": "chacha20-ietf",
      "password": "fake-ssr",
      "obfs": "http_simple",
      "obfsParam": "o.example.com",
      "protocol": "auth_aes128_sha1",
      "protocolParam": "100:fake"
    },
    {
      "name": "VMess H2",
      "type": "vmess",
      "server": "vh2.example.com",
      "port": 443,
      "uuid": "00000000-0000-4000-8000-000000000021",
      "alterId": 0,
      "cipher": "auto",
      "tls": {
        "sni": "vh2.example.com",
        "alpn": [
          "h2"
        ]
      },
      "transport": {
        "type": "h2",
        "path": "/h2",
        "host": [
          "vh2.example.com"
        ]
      }
    },
    {
      "name": "VMess HTTP",
      "type": "vmess",
      "server": "198.51.100.40",
      "port": 80,
      "uuid": "00000000-0000-4000-8000-000000000022",
      "alterId": 0,
      "cipher": "auto",
      "transport": {
        "type": "http",
        "method": "GET",
        "path": [
          "/"
        ],
        "host": [
          "a.example.com"
        ],
        "headers": {
          "Connection": [
            "keep-alive"
          ]
        }
      },
      "extra": {
        "mihomo": {
          "global-padding": true
        }
      }
    },
    {
      "name": "VLESS HTTPUpgrade",
      "type": "vless",
      "server": "up.example.com",
      "port": 443,
      "uuid": "00000000-0000-4000-8000-000000000023",
      "tls": {
        "sni": "up.example.com"
      },
      "transport": {
        "type": "httpupgrade",
        "path": "/up",
        "host": "up.example.com"
      },
      "extra": {
        "mihomo": {
          "ws-opts": {
            "v2ray-http-upgrade-fast-open": true
          }
        }
      }
    },
    {
      "name": "VLESS Reality gRPC",
      "type": "vless",
      "server": "203.0.113.40",
      "port": 443,
      "uuid": "00000000-0000-4000-8000-000000000024",
      "tls": {
        "sni": "www.example.com",
        "clientFingerprint": "chrome",
        "reality": {
          "publicKey": "Zm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm9vYmFyZm8",
          "shortId": "01234567"
        }
      },
      "transport": {
        "type": "grpc",
        "serviceName": "grpc-svc"
      },
      "extra": {
        "mihomo": {
          "smux": {
            "enabled": true,
            "protocol": "h2mux"
          }
        }
      }
    },
    {
      "name": "VLESS WS early data",
      "type": "vless",
      "server": "ed.example.com",
      "port": 443,
      "uuid": "00000000-0000-4000-8000-000000000025",
      "tls": {},
      "transport": {
        "type": "ws",
        "path": "/ed",
        "maxEarlyData": 2048,
        "earlyDataHeaderName": "Sec-WebSocket-Protocol"
      }
    },
    {
      "name": "Trojan ECH",
      "type": "trojan",
      "server": "ech.example.com",
      "port": 443,
      "password": "fake-ech",
      "tls": {
        "sni": "ech.example.com",
        "skipCertVerify": true,
        "certFingerprint": "AA:BB",
        "ech": {
          "config": "ZmFrZS1lY2g="
        }
      }
    },
    {
      "name": "Hysteria2 ports",
      "type": "hysteria2",
      "server": "2001:db8::30",
      "port": 443,
      "password": "fake-hy2",
      "ports": "443,20000-30000",
      "up": "50",
      "down": "200 Mbps",
      "tls": {
        "sni": "hy.example.com",
        "alpn": [
          "h3"
        ]
      },
      "extra": {
        "mihomo": {
          "hop-interval": 30
        }
      }
    },
    {
      "name": "TUIC",
      "type": "tuic",
      "server": "tuic.example.com",
      "port": 443,
      "uuid": "00000000-0000-4000-8000-000000000026",
      "password": "fake-tuic",
      "congestionController": "bbr",
      "udpRelayMode": "quic",
      "reduceRtt": true,
      "tls": {
        "sni": "tuic.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "name": "WireGuard",
      "type": "wireguard",
      "server": "198.51.100.41",
      "port": 51820,
      "udp": true,
      "privateKey": "ZmFrZS1wcml2YXRl",
      "publicKey": "ZmFrZS1wdWJsaWM=",
      "ip": "10.0.0.2",
      "reserved": [
        1,
        2,
        3
      ],
      "mtu": 1280,
      "extra": {
        "mihomo": {
          "allowed-ips": [
            "0.0.0.0/0"
          ]
        }
      }
    },
    {
      "name": "AnyTLS",
      "type": "anytls",
      "server": "anytls.example.com",
      "port": 443,
      "password": "fake-anytls",
      "tls": {
        "sni": "anytls.example.com"
      },
      "extra": {
        "mihomo": {
          "idle-session-check-interval": 30
        }
      }
    },
    {
      "name": "HTTP TLS",
      "type": "http",
      "server": "http.example.com",
      "port": 443,
      "username": "fake-user",
      "password": "fake-pass",
      "tls": {
        "sni": "http.example.com"
      }
    },
    {
      "name": "SOCKS5",
      "type": "socks5",
      "server": "198.51.100.42",
      "port": 1080,
      "udp": true,
      "username": "fake-user",
      "password": "fake-pass"
    }
  ],
  "config": {
    "general": {
      "mixedPort": 7890,
      "allowLan": true,
      "mode": "rule",
      "logLevel": "warning"
    },
    "dns": {
      "enable": true,
      "enhancedMode": "fake-ip",
      "nameserver": [
        "https://dns.example.com/dns-query"
      ],
      "extra": {
        "mihomo": {
          "fake-ip-filter": [
            "*.lan"
          ]
        }
      }
    },
    "groups": [
      {
        "name": "节点选择",
        "type": "select",
        "members": [
          {
            "kind": "group",
            "name": "负载均衡"
          },
          {
            "kind": "proxy",
            "name": "链式"
          },
          {
            "kind": "builtin",
            "name": "DIRECT"
          },
          {
            "kind": "builtin",
            "name": "REJECT"
          },
          {
            "kind": "proxy",
            "name": "SS anchors"
          },
          {
            "kind": "proxy",
            "name": "Missing node"
          }
        ]
      },
      {
        "name": "负载均衡",
        "type": "load-balance",
        "members": [
          {
            "kind": "proxy",
            "name": "TUIC"
          },
          {
            "kind": "proxy",
            "name": "AnyTLS"
          }
        ],
        "testUrl": "https://cp.example.com/generate_204",
        "interval": 300,
        "extra": {
          "mihomo": {
            "strategy": "consistent-hashing",
            "lazy": true
          }
        }
      },
      {
        "name": "隐藏组",
        "type": "fallback",
        "members": [],
        "includeAllProxies": true,
        "filter": {
          "include": "(?i)hysteria",
          "exclude": "ports"
        },
        "hidden": true,
        "icon": "https://icon.example.com/a.png",
        "extra": {
          "mihomo": {
            "use": [
              "provider1"
            ]
          }
        }
      }
    ],
    "ruleSets": [
      {
        "id": "ads",
        "name": "ads",
        "behavior": "domain",
        "sources": {
          "mihomo": {
            "url": "https://rules.example.com/ads.mrs",
            "format": "mrs"
          }
        },
        "interval": 86400,
        "extra": {
          "mihomo": {
            "path": "./ruleset/ads.mrs"
          }
        }
      },
      {
        "id": "apps",
        "name": "apps",
        "behavior": "classical",
        "sources": {
          "mihomo": {
            "url": "https://rules.example.com/apps.list",
            "format": "text"
          }
        },
        "extra": {
          "mihomo": {
            "proxy": "DIRECT"
          }
        }
      }
    ],
    "rules": [
      {
        "type": "RULE-SET",
        "value": "ads",
        "target": "REJECT"
      },
      {
        "type": "RULE-SET",
        "value": "apps",
        "target": "节点选择"
      },
      {
        "type": "OR",
        "children": [
          {
            "type": "NOT",
            "children": [
              {
                "type": "DOMAIN",
                "value": "a.example.com"
              }
            ]
          },
          {
            "type": "AND",
            "children": [
              {
                "type": "DST-PORT",
                "value": "80"
              },
              {
                "type": "SRC-IP-CIDR",
                "value": "10.0.0.0/8"
              }
            ]
          }
        ],
        "target": "DIRECT"
      },
      {
        "type": "AND",
        "children": [
          {
            "type": "IP-CIDR",
            "value": "198.51.100.0/24",
            "noResolve": true
          },
          {
            "type": "DST-PORT",
            "value": "443"
          }
        ],
        "target": "负载均衡"
      },
      {
        "type": "IP-ASN",
        "value": "64500",
        "noResolve": true,
        "target": "DIRECT"
      },
      {
        "type": "PROCESS-NAME",
        "value": "curl",
        "target": "DIRECT"
      },
      {
        "type": "DOMAIN-REGEX",
        "value": "^api\\.example\\.com$",
        "target": "节点选择"
      },
      {
        "type": "IP-CIDR",
        "value": "203.0.113.0/24",
        "target": "DIRECT"
      },
      {
        "type": "MATCH",
        "target": "节点选择"
      }
    ],
    "extra": {
      "mihomo": {
        "unified-delay": true,
        "tun": {
          "enable": true,
          "stack": "mixed"
        },
        "proxy-providers": {
          "provider1": {
            "type": "http",
            "url": "https://sub.example.com/provider.yaml",
            "interval": 3600
          }
        },
        "common": {
          "udp": true,
          "ip-version": "ipv4"
        }
      }
    }
  },
  "warnings": [
    {
      "level": "warn",
      "code": "INVALID_PROXY",
      "protocol": "trojan",
      "path": "proxies[16]",
      "message": "invalid proxy: \"server\" is required"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_PROTOCOL",
      "protocol": "snell",
      "path": "proxies[17]",
      "message": "protocol \"snell\" is not supported"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_TRANSPORT",
      "protocol": "vless",
      "path": "proxies[18]",
      "message": "transport \"xhttp\" is not supported"
    },
    {
      "level": "info",
      "code": "UNKNOWN_GROUP_MEMBER",
      "path": "proxy-groups[0].proxies[1]",
      "message": "member is neither a proxy, a group nor a built-in target"
    },
    {
      "level": "info",
      "code": "UNKNOWN_GROUP_MEMBER",
      "path": "proxy-groups[0].proxies[5]",
      "message": "member is neither a proxy, a group nor a built-in target"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_GROUP_TYPE",
      "path": "proxy-groups[2]",
      "message": "group type \"relay\" is not supported"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_RULE_PROVIDER",
      "path": "rule-providers.local",
      "message": "rule provider type \"file\" is not supported"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_RULE_TYPE",
      "path": "rules[7]",
      "message": "rule type \"PROCESS-PATH\" is not supported"
    },
    {
      "level": "warn",
      "code": "UNSUPPORTED_RULE_TYPE",
      "path": "rules[8]",
      "message": "rule type \"SUB-RULE\" is not supported"
    },
    {
      "level": "warn",
      "code": "INVALID_RULE",
      "path": "rules[9]",
      "message": "missing target"
    },
    {
      "level": "info",
      "code": "UNSUPPORTED_RULE_PARAM",
      "path": "rules[10]",
      "message": "ignored unsupported parameters: src"
    }
  ]
}
